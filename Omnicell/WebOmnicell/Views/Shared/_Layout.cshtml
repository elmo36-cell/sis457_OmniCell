@{
    // El catálogo usa una pantalla fija sin scroll; el resto de páginas fluye normal.
    string claseCuerpo = ViewData["BodyClass"] as string ?? string.Empty;
    string usuario = Context.Session.GetString("usuario") ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OmniCell</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Estilos personalizados de OmniCell -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@claseCuerpo">

    <!-- ENCABEZADO: logo, buscador y sesión -->
    <header class="app-header">
        <div class="header-inner">

            <!-- LOGO -->
            <a asp-controller="Catalogo" asp-action="Index" class="brand-logo">
                <div class="brand-icon">
                    <i class="bi bi-phone"></i>
                </div>

                <div class="brand-text">
                    <span class="brand-name">OmniCell</span>
                    <span class="brand-subtitle">Repuestos y componentes</span>
                </div>
            </a>


            <!-- BUSCADOR -->
            <form class="search-form" method="get"
                  asp-controller="Catalogo" asp-action="Index">

                <i class="bi bi-search search-icon"></i>

                <input type="search"
                       name="parametro"
                       class="search-input"
                       value="@ViewBag.Parametro"
                       placeholder="Buscar por modelo, SKU o calidad..." />

                @if (!string.IsNullOrEmpty(ViewBag.Calidad as string))
                {
                    <input type="hidden" name="calidad" value="@ViewBag.Calidad" />
                }

                <button type="submit" class="search-button" aria-label="Buscar">
                    Buscar
                </button>
            </form>


            <!-- SESIÓN -->
            <div class="header-user">
                @if (!string.IsNullOrEmpty(usuario))
                {
                    <a class="logout-link"
                       asp-controller="Tablas"
                       asp-action="Index"
                       title="Módulos según tu rol">
                        <i class="bi bi-grid"></i>
                        <span>Módulos</span>
                    </a>

                    <span class="user-chip" title="@(Context.Session.GetString("rolNombre") ?? "Sesión iniciada")">
                        <i class="bi bi-person-circle"></i>
                        <span>@usuario</span>
                    </span>

                    <a class="logout-link"
                       asp-controller="Account"
                       asp-action="CerrarSesion"
                       title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Salir</span>
                    </a>
                }
                else
                {
                    <a class="logout-link"
                       asp-controller="Account"
                       asp-action="IniciarSesion">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Entrar</span>
                    </a>
                }
            </div>

        </div>
    </header>


    <!-- CONTENIDO DE CADA PÁGINA -->
    <main class="app-main">
        @RenderBody()
    </main>


    <!-- PIE COMPACTO -->
    <footer class="app-footer">
        <span>© @DateTime.Now.Year OmniCell</span>
        <span>Repuestos, pantallas y componentes para dispositivos móviles</span>
    </footer>


    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts personalizados -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

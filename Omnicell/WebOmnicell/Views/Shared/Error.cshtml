@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ocurrió un problema al procesar su solicitud.</h2>

@if (Model.MostrarIdSolicitud)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@Model.IdSolicitud</code>
    </p>
}

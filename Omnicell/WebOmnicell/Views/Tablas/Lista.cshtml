@model WebOmnicell.Models.TablaViewModel

@{
    ViewData["Title"] = Model.Titulo;
    ViewData["BodyClass"] = "app-shell";
}

<div class="table-layout">

    <div class="table-panel">

        @if (TempData["ok"] is string aviso)
        {
            <div class="flash-ok">
                <i class="bi bi-check-circle"></i>
                <span>@aviso</span>
            </div>
        }

        <!-- Encabezado del módulo -->
        <div class="catalog-toolbar">

            <div class="toolbar-text">
                <nav class="crumbs">
                    <a asp-controller="Tablas" asp-action="Index">
                        <i class="bi bi-grid"></i>
                        Módulos
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>@Model.Titulo</span>
                </nav>

                <h1>@Model.Titulo</h1>
                <p>
                    @Model.Total registro(s) · página @Model.Pagina de @Model.TotalPaginas
                </p>
            </div>

            <div class="toolbar-actions">

                @if (Model.AccionEditar != null && Model.TextoNuevo != null)
                {
                    <a class="btn-primary btn-new" asp-action="@Model.AccionEditar">
                        <i class="bi bi-plus-lg"></i>
                        @Model.TextoNuevo
                    </a>
                }

                <form class="mini-search" method="get" asp-action="@Model.Accion">
                    <i class="bi bi-search"></i>

                    <input type="search"
                           name="parametro"
                           value="@Model.Parametro"
                           placeholder="Buscar en @Model.Titulo..." />

                    @if (Model.FiltroTexto != null)
                    {
                        <input type="hidden" name="soloBajo" value="@(Model.FiltroActivo ? "true" : "false")" />
                    }

                    <button type="submit">Buscar</button>
                </form>

                @if (Model.FiltroTexto != null)
                {
                    <a class="filter-toggle @(Model.FiltroActivo ? "activo" : "")"
                       asp-action="@Model.Accion"
                       asp-route-parametro="@Model.Parametro"
                       asp-route-soloBajo="@(Model.FiltroActivo ? null : "true")">
                        <i class="bi bi-exclamation-triangle"></i>
                        @Model.FiltroTexto
                        <span class="filter-count">@Model.FiltroTotal</span>
                    </a>
                }

                <a class="clear-filters" asp-controller="Tablas" asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Módulos
                </a>

            </div>

        </div>


        <!-- Tabla -->
        <div class="table-wrap">

            <table class="data-table">

                <thead>
                    <tr>
                        @foreach (string columna in Model.Columnas)
                        {
                            <th>@columna</th>
                        }

                        @if (Model.AccionEditar != null)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @for (int f = 0; f < Model.Filas.Count; f++)
                    {
                        string[] fila = Model.Filas[f];
                        bool alerta = f < Model.Alertas.Count && Model.Alertas[f];

                        <tr class="@(alerta ? "fila-alerta" : null)">
                            @for (int i = 0; i < Model.Columnas.Length; i++)
                            {
                                <td>
                                    @(i < fila.Length ? fila[i] : "")
                                    @if (alerta && i == Model.ColumnaAlerta)
                                    {
                                        <span class="stock-bajo" title="Stock igual o por debajo del mínimo">bajo</span>
                                    }
                                </td>
                            }

                            @if (Model.AccionEditar != null && f < Model.Ids.Count)
                            {
                                <td class="row-actions">
                                    <a class="row-link" asp-action="@Model.AccionEditar" asp-route-id="@Model.Ids[f]">
                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>

            </table>

            @if (Model.Filas.Count == 0)
            {
                <div class="table-empty">
                    <i class="bi bi-inbox"></i>
                    <p>
                        @(Model.FiltroActivo
                            ? "Ningún registro está en o por debajo del mínimo."
                            : "No hay registros que coincidan con la búsqueda.")
                    </p>
                </div>
            }

        </div>


        <!-- Paginación -->
        <div class="pager">

            @if (Model.Pagina > 1)
            {
                <a class="pager-button"
                   asp-action="@Model.Accion"
                   asp-route-parametro="@Model.Parametro"
                   asp-route-soloBajo="@(Model.FiltroActivo ? "true" : null)"
                   asp-route-pagina="@(Model.Pagina - 1)">
                    <i class="bi bi-chevron-left"></i>
                    Anterior
                </a>
            }
            else
            {
                <span class="pager-button disabled">
                    <i class="bi bi-chevron-left"></i>
                    Anterior
                </span>
            }

            <span class="pager-info">
                Página @Model.Pagina de @Model.TotalPaginas
            </span>

            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a class="pager-button"
                   asp-action="@Model.Accion"
                   asp-route-parametro="@Model.Parametro"
                   asp-route-soloBajo="@(Model.FiltroActivo ? "true" : null)"
                   asp-route-pagina="@(Model.Pagina + 1)">
                    Siguiente
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="pager-button disabled">
                    Siguiente
                    <i class="bi bi-chevron-right"></i>
                </span>
            }

        </div>

    </div>

</div>

@model List<WebOmnicell.Models.Pantalla>
@using WebOmnicell.Servicios
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Entorno

@{
    ViewData["Title"] = "Catálogo";
    ViewData["BodyClass"] = "app-shell";

    // Datos que manda CatalogoController para el panel de filtros y la paginación.
    var calidades = ViewBag.Calidades as List<string> ?? new List<string>();
    var marcas = ViewBag.Marcas as List<Marca> ?? new List<Marca>();
    var modelos = ViewBag.Modelos as List<Modelo> ?? new List<Modelo>();

    string parametro = ViewBag.Parametro as string ?? string.Empty;
    string calidadActual = ViewBag.Calidad as string ?? string.Empty;
    string marcaNombre = ViewBag.MarcaNombre as string ?? string.Empty;
    string modeloNombre = ViewBag.ModeloNombre as string ?? string.Empty;

    int? marcaActual = ViewBag.Marca as int?;
    int? modeloActual = ViewBag.Modelo as int?;

    string ordenActual = ViewBag.Orden as string ?? string.Empty;
    bool soloDisponibles = ViewBag.SoloDisponibles as bool? ?? false;

    // Orden y "solo disponibles" viajan en cada enlace para no perderse al
    // cambiar de filtro, de página o al usar el buscador.
    string? ordenParam = ordenActual.Length > 0 ? ordenActual : null;
    string? disponibleParam = soloDisponibles ? "true" : null;

    int total = ViewBag.Total as int? ?? Model.Count;
    int conStock = ViewBag.ConStock as int? ?? 0;

    // Productos de esta página con stock en alguna sucursal.
    var disponibles = (ViewBag.Disponibles as List<int> ?? new List<int>()).ToHashSet();
    int pagina = ViewBag.Pagina as int? ?? 1;
    int totalPaginas = ViewBag.TotalPaginas as int? ?? 1;

    // Con una marca o un modelo elegido también hay filtro, aunque no se escriba nada.
    bool hayFiltro = parametro.Length > 0 || calidadActual.Length > 0
        || marcaActual.HasValue || modeloActual.HasValue || soloDisponibles;

    // El título muestra lo más específico que eligió el cliente.
    string titulo = modeloNombre.Length > 0 ? modeloNombre
        : marcaNombre.Length > 0 ? marcaNombre
        : calidadActual.Length > 0 ? calidadActual
        : parametro.Length > 0 ? "Resultados de búsqueda"
        : "Todas las pantallas";
}

<div class="catalog-layout">

    <!-- PANEL LATERAL: resumen y filtros -->
    <aside class="catalog-side">

        <div class="panel-card summary-card">

            <span class="eyebrow">INVENTARIO</span>

            <div class="summary-stats">
                <div>
                    <strong>@total</strong>
                    <span>Pantallas</span>
                </div>

                <div>
                    <strong>@conStock.ToString("N0")</strong>
                    <span>Con stock</span>
                </div>
            </div>

            <p class="summary-note">
                Precios en bolivianos. Filtra por marca y modelo, o escribe el
                celular en el buscador («iPhone 13»). Toca un producto para ver
                sus modelos compatibles y si está disponible.
            </p>

        </div>


        <!-- CALIDAD: pocos valores, así que la lista se ve completa -->
        <div class="panel-card filters-card compacta">

            <h2 class="panel-title">Calidad</h2>

            <div class="filter-list">

                <a class="filter-item @(calidadActual.Length == 0 ? "active" : "")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-orden="@ordenParam"
                   asp-route-soloDisponibles="@disponibleParam">
                    <span>Todas</span>
                </a>

                @foreach (string calidad in calidades)
                {
                    <a class="filter-item @(calidadActual == calidad ? "active" : "")"
                       asp-controller="Catalogo"
                       asp-action="Index"
                       asp-route-parametro="@parametro"
                       asp-route-calidad="@calidad"
                       asp-route-marca="@marcaActual"
                       asp-route-modelo="@modeloActual"
                       asp-route-orden="@ordenParam"
                       asp-route-soloDisponibles="@disponibleParam">
                        <span>@calidad</span>
                    </a>
                }

            </div>

        </div>


        <!-- MARCAS: solo las que tienen pantallas compatibles registradas -->
        <div class="panel-card filters-card marcas">

            <h2 class="panel-title">Marca</h2>

            <div class="filter-list">

                <a class="filter-item @(marcaActual.HasValue ? "" : "active")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-orden="@ordenParam"
                   asp-route-soloDisponibles="@disponibleParam">
                    <span>Todas</span>
                </a>

                @foreach (Marca marca in marcas)
                {
                    <a class="filter-item @(marcaActual == marca.id ? "active" : "")"
                       asp-controller="Catalogo"
                       asp-action="Index"
                       asp-route-parametro="@parametro"
                       asp-route-calidad="@calidadActual"
                       asp-route-marca="@marca.id"
                       asp-route-orden="@ordenParam"
                       asp-route-soloDisponibles="@disponibleParam">
                        <span>@marca.nombre</span>
                    </a>
                }

            </div>

        </div>


        <!-- MODELOS: son muchos en total, se listan al elegir la marca -->
        @if (modelos.Count > 0)
        {
            <div class="panel-card filters-card modelos">

                <h2 class="panel-title">Modelo</h2>

                <div class="filter-list">

                    <a class="filter-item @(modeloActual.HasValue ? "" : "active")"
                       asp-controller="Catalogo"
                       asp-action="Index"
                       asp-route-parametro="@parametro"
                       asp-route-calidad="@calidadActual"
                       asp-route-marca="@marcaActual"
                       asp-route-orden="@ordenParam"
                       asp-route-soloDisponibles="@disponibleParam">
                        <span>Todos</span>
                    </a>

                    @foreach (Modelo modeloFiltro in modelos)
                    {
                        <a class="filter-item @(modeloActual == modeloFiltro.id ? "active" : "")"
                           asp-controller="Catalogo"
                           asp-action="Index"
                           asp-route-parametro="@parametro"
                           asp-route-calidad="@calidadActual"
                           asp-route-marca="@marcaActual"
                           asp-route-modelo="@modeloFiltro.id"
                           asp-route-orden="@ordenParam"
                           asp-route-soloDisponibles="@disponibleParam">
                            <span>@modeloFiltro.nombre</span>
                        </a>
                    }

                </div>

            </div>
        }

    </aside>


    <!-- LISTA DE PRODUCTOS -->
    <section class="catalog-main">

        <div class="catalog-toolbar">

            <div class="toolbar-text">
                <span class="eyebrow">@(hayFiltro ? "RESULTADOS" : "CATÁLOGO")</span>
                <h1>@titulo</h1>

                <p>
                    @total producto(s)
                    @if (parametro.Length > 0)
                    {
                        <span>para «@parametro»</span>
                    }
                    @if (calidadActual.Length > 0)
                    {
                        <span>· @calidadActual</span>
                    }
                </p>
            </div>

            <!-- ORDEN Y FILTRO RÁPIDO: se mantienen al paginar y al buscar -->
            <div class="toolbar-filters">

                <span class="toolbar-label">Orden</span>

                <a class="toolbar-filter @(ordenActual.Length == 0 ? "active" : "")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-soloDisponibles="@disponibleParam"
                   title="Orden alfabético por descripción">
                    <i class="bi bi-sort-alpha-down"></i>
                    Nombre
                </a>

                <a class="toolbar-filter @(ordenActual == "precio-asc" ? "active" : "")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-soloDisponibles="@disponibleParam"
                   asp-route-orden="precio-asc"
                   title="Ordenar de menor a mayor precio">
                    <i class="bi bi-sort-numeric-down"></i>
                    Menor precio
                </a>

                <a class="toolbar-filter @(ordenActual == "precio-desc" ? "active" : "")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-soloDisponibles="@disponibleParam"
                   asp-route-orden="precio-desc"
                   title="Ordenar de mayor a menor precio">
                    <i class="bi bi-sort-numeric-up"></i>
                    Mayor precio
                </a>

                <a class="toolbar-filter @(soloDisponibles ? "active" : "")"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-orden="@ordenParam"
                   asp-route-soloDisponibles="@(soloDisponibles ? null : "true")"
                   title="@(soloDisponibles ? "Ver también los productos sin stock" : "Ver solo los productos con stock") ">
                    <i class="bi bi-check2-circle"></i>
                    Solo disponibles
                </a>

                @if (hayFiltro)
                {
                    <a class="clear-filters"
                       asp-controller="Catalogo"
                       asp-action="Index">
                        <i class="bi bi-x-circle"></i>
                        Limpiar filtros
                    </a>
                }

            </div>

        </div>


        <div class="products-scroll">

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h2>Sin resultados</h2>
                    <p>No hay pantallas que coincidan con la búsqueda.</p>

                    @if (marcaNombre.Length > 0 || modeloNombre.Length > 0)
                    {
                        <p>Probá con otra marca o modelo, o mirá todo el catálogo.</p>
                    }

                    <a class="btn-primary"
                       asp-controller="Catalogo"
                       asp-action="Index">
                        Ver todo el catálogo
                    </a>
                </div>
            }
            else
            {
                <div class="products-grid">

                    @foreach (var pantalla in Model)
                    {
                        string? imagen = Imagenes.RutaPantalla(Entorno, pantalla.sku, pantalla.calidad);

                        <div class="product-card">

                        <a class="product-card-link"
                           asp-controller="Catalogo"
                           asp-action="Detalle"
                           asp-route-id="@pantalla.id">

                            <div class="product-thumb">

                                @if (imagen != null)
                                {
                                    <img src="@imagen"
                                         alt="@pantalla.descripcion"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <i class="bi bi-phone"></i>
                                }

                                <span class="product-badge">@pantalla.calidad</span>
                            </div>

                            <div class="product-body">

                                <span class="product-sku">@pantalla.sku</span>

                                <h3 title="@pantalla.descripcion">
                                    @pantalla.descripcion
                                </h3>

                                <div class="product-meta">
                                    <span>
                                        <i class="bi bi-layers"></i>
                                        @pantalla.tecnologia
                                    </span>

                                    @{
                                        bool hayStock = disponibles.Contains(pantalla.id);
                                    }

                                    <span class="product-stock @(hayStock ? "" : "out")">
                                        <i class="bi @(hayStock ? "bi-check-circle" : "bi-x-circle")"></i>
                                        @(hayStock ? "Disponible" : "Sin stock")
                                    </span>
                                </div>

                            </div>

                        </a>

                        <!-- Agregar al carrito: va fuera del enlace para no anidar formularios -->
                        <div class="product-footer">

                            <span class="product-price">
                                Bs @pantalla.precioVenta.ToString("N2")
                            </span>

                            <form method="post"
                                  asp-controller="Carrito"
                                  asp-action="Agregar"
                                  class="product-add">

                                <input type="hidden" name="id" value="@pantalla.id" />
                                <input type="hidden" name="cantidad" value="1" />
                                <input type="hidden" name="volver"
                                       value="@(Context.Request.Path + Context.Request.QueryString)" />

                                <button type="submit" class="btn-add"
                                        title="Agregar @pantalla.sku al carrito">
                                    <i class="bi bi-bag-plus"></i>
                                    Agregar
                                </button>

                            </form>

                        </div>

                        </div>
                    }

                </div>
            }

        </div>


        <!-- Paginación: 10 productos por página -->
        <div class="pager catalog-pager">

            @if (pagina > 1)
            {
                <a class="pager-button"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-orden="@ordenParam"
                   asp-route-soloDisponibles="@disponibleParam"
                   asp-route-pagina="@(pagina - 1)">
                    <i class="bi bi-chevron-left"></i>
                    Anterior
                </a>
            }
            else
            {
                <span class="pager-button disabled">
                    <i class="bi bi-chevron-left"></i>
                    Anterior
                </span>
            }

            <span class="pager-info">Página @pagina de @totalPaginas</span>

            @if (pagina < totalPaginas)
            {
                <a class="pager-button"
                   asp-controller="Catalogo"
                   asp-action="Index"
                   asp-route-parametro="@parametro"
                   asp-route-calidad="@calidadActual"
                   asp-route-marca="@marcaActual"
                   asp-route-modelo="@modeloActual"
                   asp-route-orden="@ordenParam"
                   asp-route-soloDisponibles="@disponibleParam"
                   asp-route-pagina="@(pagina + 1)">
                    Siguiente
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="pager-button disabled">
                    Siguiente
                    <i class="bi bi-chevron-right"></i>
                </span>
            }

        </div>

    </section>

</div>

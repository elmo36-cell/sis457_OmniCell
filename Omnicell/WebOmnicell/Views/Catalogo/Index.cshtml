@model List<WebOmnicell.Models.Pantalla>
@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo de pantallas</h1>

<form asp-action="Index" method="get">
    <input type="text" name="parametro" value="@Context.Request.Query["parametro"]" placeholder="Buscar por SKU, descripción o calidad" size="40" />
    <button type="submit">Buscar</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Descripción</th>
            <th>Calidad</th>
            <th>Tecnología</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pantalla in Model)
        {
            <tr>
                <td>@pantalla.sku</td>
                <td>@pantalla.descripcion</td>
                <td>@pantalla.calidad</td>
                <td>@pantalla.tecnologia</td>
                <td>@pantalla.precioVenta.ToString("N2")</td>
                <td>@pantalla.stockTotal.ToString("N2")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6">No se encontraron pantallas.</td>
            </tr>
        }
    </tbody>
</table>
